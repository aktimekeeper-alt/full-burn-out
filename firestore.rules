rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return request.auth.uid == uid;
    }

    // Users
    match /users/{userId} {
      allow read: if isAuth();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
    }

    // Vehicles
    match /vehicles/{vehicleId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update, delete: if isAuth() && resource.data.ownerId == request.auth.uid;
    }

    // Posts
    match /posts/{postId} {
      allow read: if isAuth();
      allow create: if isAuth();
      // Allow updates for likes/comments by any authenticated user; delete only by author
      allow update: if isAuth();
      allow delete: if isAuth() && resource.data.authorId == request.auth.uid;
    }

    // Meets
    match /meets/{meetId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update: if isAuth();
      allow delete: if isAuth() && resource.data.hostId == request.auth.uid;

      // Live attendee locations subcollection
      match /attendeeLocations/{uid} {
        allow read: if isAuth();
        allow write: if isOwner(uid);
        allow delete: if isOwner(uid);
      }
    }

    // Chats
    match /chats/{chatId} {
      allow read: if isAuth() && request.auth.uid in resource.data.members;
      allow create: if isAuth();
      allow update: if isAuth() && request.auth.uid in resource.data.members;

      // Messages subcollection
      match /messages/{messageId} {
        allow read: if isAuth();
        allow create: if isAuth();
      }
    }
  }
}
